<?xml version="1.0" encoding="utf-8"?>
<!-- Assets/UI/HUD.uxml -->
<ui:UXML xmlns:ui="UnityEngine.UIElements">

    <ui:Style src="CarDerby.uss" />

    <!-- picking-mode=Ignore so the HUD doesn't eat mouse clicks -->
    <ui:VisualElement name="hud-root" class="hud-root" picking-mode="Ignore">

        <!-- Local player HP bar — bottom-left -->
        <ui:VisualElement name="health-container" class="health-container" picking-mode="Ignore">
            <ui:Label text="HP" class="hud-label" />
            <ui:VisualElement name="health-bar-bg" class="bar-bg">
                <ui:VisualElement name="health-bar-fill" class="bar-fill" />
            </ui:VisualElement>
            <ui:Label name="health-value" text="100" class="hud-value" />
        </ui:VisualElement>

        <!-- Speed — bottom-right -->
        <ui:VisualElement name="speed-container" class="speed-container" picking-mode="Ignore">
            <ui:Label name="speed-value" text="0" class="speed-value" />
            <ui:Label text="КМ/Ч" class="speed-unit" />
        </ui:VisualElement>

        <!-- Enemy world-space HP bars are injected here at runtime by WorldSpaceHealthBar.cs -->
        <ui:VisualElement name="ws-overlay" class="ws-overlay" picking-mode="Ignore" />

        <!-- ── MOBILE TOUCH CONTROLS (hidden on PC) ─────────────────────── -->
        <ui:VisualElement name="mobile-controls" class="mobile-controls hidden">

            <!-- Left joystick -->
            <ui:VisualElement name="joystick-zone" class="joystick-zone">
                <ui:VisualElement name="joystick-base" class="joystick-base">
                    <ui:VisualElement name="joystick-knob" class="joystick-knob" />
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- Brake -->
            <ui:VisualElement name="brake-btn" class="mobile-btn mobile-brake-btn">
                <ui:Label text="BRAKE" class="mobile-btn-label" />
            </ui:VisualElement>

            <!-- Nitro -->
            <ui:VisualElement name="nitro-btn" class="mobile-btn mobile-nitro-btn">
                <ui:Label text="NITRO" class="mobile-btn-label" />
            </ui:VisualElement>

            <!-- Fire -->
            <ui:VisualElement name="fire-btn" class="mobile-btn mobile-fire-btn">
                <ui:Label text="FIRE" class="mobile-btn-label" />
            </ui:VisualElement>

        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
